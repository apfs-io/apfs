LOG_LEVEL=info

# HTTP :8080  gRPC :8081  (mapped on the host by docker-compose.yaml)
SERVER_HTTP_LISTEN=:8080
SERVER_GRPC_LISTEN=:8081

# Local filesystem storage (default). Uncomment S3 and comment fs:// to switch.
STORAGE_CONNECT=fs:///data/storage
# STORAGE_CONNECT=s3://s3.example.com:9000/assets?access=ACCESS_KEY&secret=SECRET_KEY&region=default
# STORAGE_ENSURE_BUCKET=true

STORAGE_METADB_CONNECT=sqlite3:///data/meta/apfs.db?cache=shared
STORAGE_STATE_CONNECT=redis://redis:6379/0
STORAGE_PROCEDURE_DIR=/procedures/
STORAGE_CONVERTERS=image,procedure,shell,exec,docker

EVENTSTREAM_CONNECT=redis://redis:6379/1?topics=events
PROCESSING_STATUS_STREAM_CONNECT=redis://redis:6379/1?topics=status
PROCESSING_INTERLOCK_CONNECTION=redis://redis:6379/2?pool=2&max_retries=2
PROCESSING_LIFETIME=5m

WORKFLOWS_DIR=/workflows
WORKFLOWS_RECONFIGURE=false
WORKER_TAGS=image,gpu,cpu,docker,video,any
